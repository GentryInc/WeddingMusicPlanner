<Window x:Class="WeddingMusicPlannerPro.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:b="clr-namespace:WeddingMusicPlannerPro.Wpf.Behaviors"
        xmlns:vm="clr-namespace:WeddingMusicPlannerPro.Wpf.ViewModels"
        mc:Ignorable="d"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="Wedding Music Planner Pro" Height="720" Width="1200"
        Background="{StaticResource BackgroundBrush}"
        Loaded="OnLoaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== Transport / toolbar ===== -->
        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" Padding="16,10">
            <StackPanel>
            <DockPanel>
                <ToggleButton DockPanel.Dock="Right"
                              Content="LOCKOUT"
                              IsChecked="{Binding IsLockoutEnabled, Mode=OneWay}"
                              Command="{Binding ToggleLockoutCommand}"
                              AutomationProperties.Name="Toggle Lockout Mode"
                              AutomationProperties.HelpText="Disables non-essential controls to prevent accidental clicks during the ceremony."
                              MinWidth="120" MinHeight="40" Foreground="{StaticResource ForegroundBrush}"
                              Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource AccentBrush}"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Content="Import Music" Command="{Binding ImportCommand}"
                            AutomationProperties.Name="Import your own music files"
                            AutomationProperties.HelpText="Upload MP3, MP4, M4A, WAV, FLAC or AAC files into the library."
                            Margin="0,0,8,0"/>
                    <Button Content="Settings" Command="{Binding OpenSettingsCommand}"
                            AutomationProperties.Name="Configure API keys"
                            AutomationProperties.HelpText="Set YouTube and Spotify API keys for music search."
                            Margin="0,0,8,0"/>
                    <Button Content="Request QR" Command="{Binding ShowRequestQrCommand}"
                            AutomationProperties.Name="Show guest song request QR code"
                            AutomationProperties.HelpText="Displays a QR code guests scan to request songs from their phones."
                            Margin="0,0,16,0"/>
                    <Button Content="Preview (Cue)" Command="{Binding PreviewCommand}"
                            CommandParameter="{Binding SelectedTrack}"
                            AutomationProperties.Name="Preview selected track on headphones" Margin="0,0,8,0"/>
                    <Button Content="Play (Master)" Command="{Binding PlayCommand}"
                            CommandParameter="{Binding SelectedTrack}"
                            AutomationProperties.Name="Play selected track on main output" Margin="0,0,8,0"/>
                    <Button Content="Pause" Command="{Binding PauseCommand}"
                            AutomationProperties.Name="Pause playback" Margin="0,0,8,0"/>
                    <Button Content="Resume" Command="{Binding ResumeCommand}"
                            AutomationProperties.Name="Resume playback"/>

                    <!-- ===== Playlist builder: reorder / remove the selected track ===== -->
                    <Separator Margin="12,0" Background="{StaticResource AccentBrush}"/>
                    <Button Content="Move Up" Command="{Binding MoveTrackUpCommand}"
                            CommandParameter="{Binding SelectedTrack}"
                            AutomationProperties.Name="Move selected track up in its segment"
                            AutomationProperties.HelpText="Moves the selected track one position earlier in its segment."
                            Margin="0,0,8,0"/>
                    <Button Content="Move Down" Command="{Binding MoveTrackDownCommand}"
                            CommandParameter="{Binding SelectedTrack}"
                            AutomationProperties.Name="Move selected track down in its segment"
                            AutomationProperties.HelpText="Moves the selected track one position later in its segment."
                            Margin="0,0,8,0"/>
                    <Button Content="Remove" Command="{Binding RemoveTrackCommand}"
                            CommandParameter="{Binding SelectedTrack}"
                            AutomationProperties.Name="Remove selected track from its segment"
                            AutomationProperties.HelpText="Removes the selected track from the playlist segment that contains it."/>

                    <!-- ===== Playlist management: add a new playlist ===== -->
                    <Separator Margin="12,0" Background="{StaticResource AccentBrush}"/>
                    <Button Content="Add Playlist" Command="{Binding AddSegmentCommand}"
                            AutomationProperties.Name="Add a new playlist"
                            AutomationProperties.HelpText="Creates a new, empty playlist segment."/>
                </StackPanel>
            </DockPanel>

            <!-- ===== Music controls: master volume + playhead readout ===== -->
            <DockPanel Margin="0,10,0,0">
                <TextBlock DockPanel.Dock="Left" Text="Volume" VerticalAlignment="Center"
                           Foreground="{StaticResource SubtleTextBrush}" Margin="0,0,8,0"/>
                <TextBlock DockPanel.Dock="Right" Text="{Binding PositionDisplay}"
                           VerticalAlignment="Center" MinWidth="90" Margin="12,0,0,0"
                           Foreground="{StaticResource ForegroundBrush}"
                           AutomationProperties.Name="Playback position"
                           AutomationProperties.LiveSetting="Polite"/>
                <Slider x:Name="SeekSlider" DockPanel.Dock="Right" Width="220"
                        Minimum="0" Maximum="{Binding DurationSeconds}"
                        Value="{Binding PositionSeconds, Mode=OneWay}"
                        VerticalAlignment="Center" Margin="12,0,0,0"
                        Thumb.DragStarted="OnSeekDragStarted"
                        Thumb.DragCompleted="OnSeekDragCompleted"
                        AutomationProperties.Name="Seek"
                        AutomationProperties.HelpText="Drag to reposition playback within the current track."/>
                <Slider Minimum="0" Maximum="1" Value="{Binding MasterVolume, Mode=TwoWay}"
                        Width="200" VerticalAlignment="Center" TickFrequency="0.1"
                        IsMoveToPointEnabled="True" SmallChange="0.01" LargeChange="0.1"
                        AutomationProperties.Name="Master volume"
                        AutomationProperties.HelpText="Adjusts the main output level from silent to full."/>
            </DockPanel>

            <!-- ===== 3-band equalizer (low / mid / high, ±12 dB) ===== -->
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Text="EQ" VerticalAlignment="Center" Margin="0,0,12,0"
                           Foreground="{StaticResource SubtleTextBrush}"/>

                <TextBlock Text="Low" VerticalAlignment="Center" Margin="0,0,4,0"
                           Foreground="{StaticResource SubtleTextBrush}"/>
                <Slider Minimum="-12" Maximum="12" Value="{Binding EqLowDb, Mode=TwoWay}"
                        Width="140" VerticalAlignment="Center" TickFrequency="3"
                        AutomationProperties.Name="Equalizer low band gain in decibels"/>

                <TextBlock Text="Mid" VerticalAlignment="Center" Margin="16,0,4,0"
                           Foreground="{StaticResource SubtleTextBrush}"/>
                <Slider Minimum="-12" Maximum="12" Value="{Binding EqMidDb, Mode=TwoWay}"
                        Width="140" VerticalAlignment="Center" TickFrequency="3"
                        AutomationProperties.Name="Equalizer mid band gain in decibels"/>

                <TextBlock Text="High" VerticalAlignment="Center" Margin="16,0,4,0"
                           Foreground="{StaticResource SubtleTextBrush}"/>
                <Slider Minimum="-12" Maximum="12" Value="{Binding EqHighDb, Mode=TwoWay}"
                        Width="140" VerticalAlignment="Center" TickFrequency="3"
                        AutomationProperties.Name="Equalizer high band gain in decibels"/>

                <Button Content="Reset EQ" Command="{Binding ResetEqCommand}" Margin="16,0,0,0"
                        AutomationProperties.Name="Reset equalizer to flat"
                        AutomationProperties.HelpText="Sets all equalizer bands back to 0 decibels."/>
            </StackPanel>

                <!-- Search filters + sort -->
                <WrapPanel Margin="0,8,0,0">
                    <TextBlock Text="Source" VerticalAlignment="Center" Margin="0,0,6,0"
               Foreground="{StaticResource SubtleTextBrush}"/>
                    <ComboBox Width="120" Margin="0,0,12,0"
              ItemsSource="{Binding Search.SourceOptions}"
              SelectedItem="{Binding Search.SelectedSource}"
              AutomationProperties.Name="Filter results by source"/>

                    <TextBlock Text="Genre" VerticalAlignment="Center" Margin="0,0,6,0"
               Foreground="{StaticResource SubtleTextBrush}"/>
                    <TextBox Width="120" Margin="0,0,12,0"
             Text="{Binding Search.Genre, UpdateSourceTrigger=PropertyChanged}"
             AutomationProperties.Name="Filter results by genre"/>

                    <TextBlock Text="Year" VerticalAlignment="Center" Margin="0,0,6,0"
               Foreground="{StaticResource SubtleTextBrush}"/>
                    <TextBox Width="55" Margin="0,0,4,0"
             Text="{Binding Search.MinYear, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
             AutomationProperties.Name="Minimum year"/>
                    <TextBlock Text="–" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox Width="55" Margin="0,0,12,0"
             Text="{Binding Search.MaxYear, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
             AutomationProperties.Name="Maximum year"/>

                    <TextBlock Text="BPM" VerticalAlignment="Center" Margin="0,0,6,0"
               Foreground="{StaticResource SubtleTextBrush}"/>
                    <TextBox Width="55" Margin="0,0,4,0"
             Text="{Binding Search.MinBpm, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
             AutomationProperties.Name="Minimum BPM"/>
                    <TextBlock Text="–" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox Width="55" Margin="0,0,12,0"
             Text="{Binding Search.MaxBpm, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
             AutomationProperties.Name="Maximum BPM"/>

                    <TextBlock Text="Sort" VerticalAlignment="Center" Margin="0,0,6,0"
               Foreground="{StaticResource SubtleTextBrush}"/>
                    <ComboBox Width="130"
              ItemsSource="{Binding Search.SortOptions}"
              SelectedItem="{Binding Search.SelectedSort}"
              AutomationProperties.Name="Sort results"/>
                </WrapPanel>

                <!-- ===== Unified search (local library + third-party providers) ===== -->
            <Grid Margin="0,12,0,0" DataContext="{Binding Search}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0">
                    <Button DockPanel.Dock="Right" Content="Search"
                            Command="{Binding SearchCommand}" MinWidth="90" Margin="8,0,0,0"
                            AutomationProperties.Name="Search local library and connected services"/>
                    <Button DockPanel.Dock="Right" Content="Trending"
                            Command="{Binding LoadTrendingCommand}" MinWidth="90" Margin="8,0,0,0"
                            AutomationProperties.Name="Show currently trending music"
                            AutomationProperties.HelpText="Loads popular tracks from connected services into the results list."/>
                    <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Search query"
                             ToolTip="Search your uploads plus Spotify, Apple Music and more"
                             VerticalContentAlignment="Center" MinHeight="32"
                             Foreground="{StaticResource ForegroundBrush}"
                             Background="#FF262626" BorderBrush="{StaticResource AccentBrush}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding SearchCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                </DockPanel>

                <TextBlock Grid.Row="1" Text="{Binding SourceStatus}" Margin="0,6,0,0"
                           Foreground="{StaticResource SubtleTextBrush}" FontSize="12"
                           AutomationProperties.LiveSetting="Polite"/>

                <ListBox Grid.Row="2" ItemsSource="{Binding Results}" Margin="0,6,0,0"
                         MaxHeight="220" Background="Transparent" BorderThickness="0"
                         AutomationProperties.Name="Search results"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:SearchResultViewModel}">
                            <Border Padding="8" Margin="0,2" CornerRadius="4" Background="#FF262626"
                                    AutomationProperties.Name="{Binding AccessibleName}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Add" MinWidth="60"
                                            Command="{Binding DataContext.AddCommand,
                                                       RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.Name="Add to playlist"/>
                                    <Border DockPanel.Dock="Right" CornerRadius="3" Padding="6,2" Margin="0,0,8,0"
                                            Background="{StaticResource PanelBrush}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SourceDisplay}" FontSize="11"
                                                   Foreground="{StaticResource SubtleTextBrush}"/>
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                   Foreground="{StaticResource ForegroundBrush}"/>
                                        <TextBlock Text="{Binding SubtitleDisplay}" FontSize="12"
                                                   Foreground="{StaticResource SubtleTextBrush}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
            </StackPanel>
        </Border>

        <!-- ===== Event Segment Buckets + Guest Requests ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Segments}"
                          AutomationProperties.Name="Event segment buckets">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:EventSegmentViewModel}">
                        <Border Width="320" Margin="10" CornerRadius="8"
                                Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                                AutomationProperties.Name="{Binding AccessibleName}">
                            <DockPanel Margin="10">
                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <!-- Editable playlist name + rename/delete -->
                                    <DockPanel LastChildFill="True">
                                        <Button DockPanel.Dock="Right" Content="✕" MinWidth="28" Margin="4,0,0,0"
                                                Command="{Binding DataContext.DeleteSegmentCommand,
                                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                AutomationProperties.Name="Delete this playlist"
                                                AutomationProperties.HelpText="Deletes this playlist and all of its track placements."/>
                                        <Button DockPanel.Dock="Right" Content="Rename" MinWidth="60"
                                                Command="{Binding DataContext.RenameSegmentCommand,
                                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                AutomationProperties.Name="Rename this playlist"
                                                AutomationProperties.HelpText="Saves the edited playlist name."/>
                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="18" FontWeight="Bold"
                                                 Background="Transparent" BorderThickness="0"
                                                 Foreground="{StaticResource ForegroundBrush}"
                                                 AutomationProperties.Name="Playlist name"/>
                                    </DockPanel>
                                    <TextBlock Text="{Binding TransitionDisplay}" FontSize="12"
                                               Foreground="{StaticResource SubtleTextBrush}"/>

                                    <!-- Loop toggle + chain-to-next selector -->
                                    <DockPanel Margin="0,6,0,0" LastChildFill="True">
                                        <ToggleButton DockPanel.Dock="Left" Content="Loop" MinWidth="56" Margin="0,0,8,0"
                                                      IsChecked="{Binding IsLooping, Mode=OneWay}"
                                                      Command="{Binding DataContext.ToggleLoopCommand,
                                                                RelativeSource={RelativeSource AncestorType=Window}}"
                                                      CommandParameter="{Binding}"
                                                      AutomationProperties.Name="Loop this playlist"
                                                      AutomationProperties.HelpText="When on, this playlist restarts after its last track instead of advancing."/>
                                        <ComboBox DockPanel.Dock="Left"
                                                  ItemsSource="{Binding DataContext.Segments,
                                                               RelativeSource={RelativeSource AncestorType=Window}}"
                                                  DisplayMemberPath="Name"
                                                  SelectedValuePath="SectionId"
                                                  SelectedValue="{Binding NextSectionId, Mode=TwoWay}"
                                                  MinWidth="120"
                                                  ToolTip="Play this playlist next"
                                                  AutomationProperties.Name="Play next playlist"/>
                                        <Button Content="Link" MinWidth="48" Margin="8,0,0,0"
                                                Command="{Binding DataContext.SetNextSegmentCommand,
                                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                AutomationProperties.Name="Save next-playlist link"
                                                AutomationProperties.HelpText="Chains the selected playlist to play after this one."/>
                                    </DockPanel>
                                    <TextBlock FontSize="11" Margin="0,4,0,0"
                                               Foreground="{StaticResource SubtleTextBrush}">
                                        <Run Text="{Binding LoopDisplay, Mode=OneWay}"/><Run Text="   "/><Run Text="{Binding NextSectionDisplay, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>

                                <!-- Drag-and-drop enabled track list -->
                                <ListBox ItemsSource="{Binding Tracks}"
                                         b:TrackDragDrop.Enable="True"
                                         Background="Transparent" BorderThickness="0"
                                         DataContext="{Binding}"
                                         SelectedItem="{Binding DataContext.SelectedTrack,
                                                        RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                                         AutomationProperties.Name="{Binding Name}"
                                         MouseDoubleClick="OnTrackDoubleClick"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:TrackViewModel}">
                                            <Border Padding="8" Margin="0,2" CornerRadius="4"
                                                    Background="#FF262626"
                                                    AutomationProperties.Name="{Binding AccessibleName}">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding DurationDisplay}"
                                                               Foreground="{StaticResource SubtleTextBrush}"/>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource ForegroundBrush}"/>
                                                        <TextBlock Foreground="{StaticResource SubtleTextBrush}" FontSize="12">
                                                            <Run Text="{Binding Artist, Mode=OneWay}"/><Run Text="  •  "/><Run Text="{Binding BpmDisplay, Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </ScrollViewer>

            <!-- ===== Guest Requests panel (QR / LAN submissions) ===== -->
            <Border Grid.Column="1" Width="280" Margin="0,10,10,10" CornerRadius="8"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
                <DockPanel Margin="10">
                    <TextBlock DockPanel.Dock="Top" Text="{Binding RequestsHeader}"
                               FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"
                               Foreground="{StaticResource ForegroundBrush}"
                               AutomationProperties.LiveSetting="Polite"/>
                    <TextBlock DockPanel.Dock="Top" Text="Guests scan the Request QR code to send songs here."
                               FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"
                               Foreground="{StaticResource SubtleTextBrush}"/>
                    <ListBox ItemsSource="{Binding PendingRequests}"
                             Background="Transparent" BorderThickness="0"
                             AutomationProperties.Name="Pending guest song requests"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SongRequestViewModel}">
                                <Border Padding="8" Margin="0,2" CornerRadius="4" Background="#FF262626">
                                    <StackPanel>
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right" CornerRadius="3" Padding="6,1"
                                                    Background="#FF7C5CFF" VerticalAlignment="Top"
                                                    Visibility="{Binding IsPriority, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="VIP" FontSize="10" FontWeight="Bold"
                                                           Foreground="White"/>
                                            </Border>
                                            <TextBlock Text="{Binding Display}" FontWeight="SemiBold"
                                                       TextWrapping="Wrap"
                                                       Foreground="{StaticResource ForegroundBrush}"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding SubDisplay}" FontSize="11"
                                                   Foreground="{StaticResource SubtleTextBrush}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <Button Content="Approve" MinWidth="70" Margin="0,0,8,0"
                                                    Command="{Binding DataContext.ApproveRequestCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    AutomationProperties.Name="Approve this song request"/>
                                            <Button Content="Reject" MinWidth="70"
                                                    Command="{Binding DataContext.RejectRequestCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    AutomationProperties.Name="Reject this song request"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ===== Status bar + Emergency ===== -->
        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" Padding="16,10">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource EmergencyButton}"
                        Content="EMERGENCY FADE (3s)"
                        Command="{Binding EmergencyFadeCommand}"
                        AutomationProperties.Name="Emergency fade out and advance"
                        AutomationProperties.HelpText="Always available, even during lockout."
                        MinWidth="260"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding NowPlaying, TargetNullValue='Nothing playing'}"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SubtleTextBrush}"
                               AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Lockout overlay: blocks stray clicks, keeps emergency reachable ===== -->
        <Border Grid.RowSpan="3" Background="{StaticResource LockoutOverlayBrush}"
                Visibility="{Binding IsLockoutEnabled, Converter={StaticResource BoolToVisibility}}"
                AutomationProperties.Name="Lockout mode engaged">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="🔒 LOCKOUT ENGAGED" FontSize="28" FontWeight="Bold"
                           HorizontalAlignment="Center" Foreground="{StaticResource ForegroundBrush}"/>
                <TextBlock Text="Non-essential controls are disabled." HorizontalAlignment="Center"
                           Foreground="{StaticResource SubtleTextBrush}" Margin="0,8"/>
                <Button Content="Release Lockout" Command="{Binding ToggleLockoutCommand}"
                        AutomationProperties.Name="Release lockout mode"
                        MinWidth="200" Margin="0,12"/>
                <Button Style="{StaticResource EmergencyButton}" Content="EMERGENCY FADE (3s)"
                        Command="{Binding EmergencyFadeCommand}"
                        AutomationProperties.Name="Emergency fade out and advance"
                        MinWidth="260"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
