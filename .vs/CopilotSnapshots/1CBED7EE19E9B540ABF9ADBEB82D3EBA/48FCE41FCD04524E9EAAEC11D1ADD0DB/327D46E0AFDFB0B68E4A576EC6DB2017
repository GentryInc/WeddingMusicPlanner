<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<OutputType>WinExe</OutputType>
	<TargetFramework>net8.0-windows</TargetFramework>
	<UseWPF>true</UseWPF>
	<Nullable>enable</Nullable>
	<ImplicitUsings>enable</ImplicitUsings>
	<LangVersion>latest</LangVersion>
	<!-- Points at a secrets.json in the user profile (outside the repo). Store API keys
		 with: dotnet user-secrets set "YouTube:ApiKey" "<key>". Never commit secrets. -->
	<UserSecretsId>weddingmusicplanner-wpf</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
	<PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
	<PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
	<PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
	<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
	<ProjectReference Include="..\WeddingAudioEngine\WeddingAudioEngine.csproj" />
	<ProjectReference Include="..\WeddingMusicData\WeddingMusicData.csproj" />
	<ProjectReference Include="..\WeddingMusicSearch\WeddingMusicSearch.csproj" />
  </ItemGroup>

</Project>
