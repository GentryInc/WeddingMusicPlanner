using System.Collections.Concurrent;
using System.Net.Http;
using System.Net.Http.Headers;
using System.Text;
using System.Text.Json;

namespace WeddingMusicPlannerPro.Wpf.Services;

/// <summary>
/// Creates and verifies DJ tip payments through hosted checkout pages.
/// Stripe: Checkout Sessions (https://docs.stripe.com/payments/checkout) —
/// the guest pays on stripe.com, we verify by retrieving the session and
/// checking payment_status == "paid". PayPal: Orders v2 — the guest approves
/// on paypal.com, we capture the order on return. No card data ever touches
/// this app, keeping it PCI SAQ-A. Keys come from Settings; a provider with
/// no key simply isn't offered to guests.
/// </summary>
public interface ITipPaymentService
{
    /// <summary>True when at least one payment provider is configured.</summary>
    bool IsConfigured { get; }

    /// <summary>Providers usable right now ("stripe", "paypal").</summary>
    IReadOnlyList<string> Providers { get; }

    /// <summary>
    /// Creates a hosted checkout for the given amount. Returns the URL to send
    /// the guest to and an opaque payment id used later for verification.
    /// </summary>
    Task<(string checkoutUrl, string paymentId)?> CreateCheckoutAsync(
        string provider, int amountCents, string returnUrl, CancellationToken ct = default);

    /// <summary>
    /// Verifies (and for PayPal, captures) the payment. Returns the confirmed
    /// amount in cents, or null when not (yet) paid.
    /// </summary>
    Task<int?> VerifyPaymentAsync(string paymentId, CancellationToken ct = default);
}

public sealed class TipPaymentService : ITipPaymentService
{
    private readonly ISettingsService _settings;
    private readonly IHttpClientFactory _httpFactory;

    // paymentId -> provider-specific session/order id ("stripe:cs_..." / "paypal:ORDER").
    private readonly ConcurrentDictionary<string, (string Provider, string ExternalId, int AmountCents)> _pending = new();

    public TipPaymentService(ISettingsService settings, IHttpClientFactory httpFactory)
    {
        _settings = settings;
        _httpFactory = httpFactory;
    }

    private bool StripeEnabled => !string.IsNullOrWhiteSpace(_settings.StripeSecretKey);
    private bool PayPalEnabled => !string.IsNullOrWhiteSpace(_settings.PayPalClientId)
                                  && !string.IsNullOrWhiteSpace(_settings.PayPalClientSecret);

    public bool IsConfigured => StripeEnabled || PayPalEnabled;

    public IReadOnlyList<string> Providers
    {
        get
        {
            var list = new List<string>(2);
            if (StripeEnabled) list.Add("stripe");
            if (PayPalEnabled) list.Add("paypal");
            return list;
        }
    }

    public async Task<(string checkoutUrl, string paymentId)?> CreateCheckoutAsync(
        string provider, int amountCents, string returnUrl, CancellationToken ct = default)
    {
        if (amountCents < 100 || amountCents > 50000) return null; // $1 .. $500 sanity bounds

        try
        {
            return provider.ToLowerInvariant() switch
            {
                "stripe" when StripeEnabled => await CreateStripeCheckoutAsync(amountCents, returnUrl, ct).ConfigureAwait(false),
                "paypal" when PayPalEnabled => await CreatePayPalCheckoutAsync(amountCents, returnUrl, ct).ConfigureAwait(false),
                _ => null
            };
        }
        catch
        {
            // Payment provider unreachable/misconfigured: tipping degrades gracefully.
            return null;
        }
    }

    public async Task<int?> VerifyPaymentAsync(string paymentId, CancellationToken ct = default)
    {
        if (!_pending.TryGetValue(paymentId, out var entry)) return null;

        try
        {
            bool paid = entry.Provider switch
            {
                "stripe" => await VerifyStripeAsync(entry.ExternalId, ct).ConfigureAwait(false),
                "paypal" => await CapturePayPalAsync(entry.ExternalId, ct).ConfigureAwait(false),
                _ => false
            };

            if (!paid) return null;
            _pending.TryRemove(paymentId, out _);
            return entry.AmountCents;
        }
        catch
        {
            return null;
        }
    }

    // --- Stripe (Checkout Sessions, form-encoded REST) ------------------------

    private async Task<(string, string)?> CreateStripeCheckoutAsync(int amountCents, string returnUrl, CancellationToken ct)
    {
        var http = _httpFactory.CreateClient("payments");
        using var request = new HttpRequestMessage(HttpMethod.Post, "https://api.stripe.com/v1/checkout/sessions");
        request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", _settings.StripeSecretKey);
        request.Content = new FormUrlEncodedContent(new Dictionary<string, string>
        {
            ["mode"] = "payment",
            ["line_items[0][price_data][currency]"] = "usd",
            ["line_items[0][price_data][product_data][name]"] = "DJ Tip",
            ["line_items[0][price_data][unit_amount]"] = amountCents.ToString(),
            ["line_items[0][quantity]"] = "1",
            ["success_url"] = returnUrl + "&paid=1",
            ["cancel_url"] = returnUrl + "&paid=0",
            ["submit_type"] = "donate"
        });

        using var response = await http.SendAsync(request, ct).ConfigureAwait(false);
        var body = await response.Content.ReadAsStringAsync(ct).ConfigureAwait(false);
        if (!response.IsSuccessStatusCode) return null;

        using var doc = JsonDocument.Parse(body);
        var sessionId = doc.RootElement.GetProperty("id").GetString();
        var url = doc.RootElement.GetProperty("url").GetString();
        if (sessionId is null || url is null) return null;

        var paymentId = Guid.NewGuid().ToString("N");
        _pending[paymentId] = ("stripe", sessionId, amountCents);
        return (url, paymentId);
    }

    private async Task<bool> VerifyStripeAsync(string sessionId, CancellationToken ct)
    {
        var http = _httpFactory.CreateClient("payments");
        using var request = new HttpRequestMessage(HttpMethod.Get, $"https://api.stripe.com/v1/checkout/sessions/{sessionId}");
        request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", _settings.StripeSecretKey);
        using var response = await http.SendAsync(request, ct).ConfigureAwait(false);
        if (!response.IsSuccessStatusCode) return false;

        var body = await response.Content.ReadAsStringAsync(ct).ConfigureAwait(false);
        using var doc = JsonDocument.Parse(body);
        return doc.RootElement.TryGetProperty("payment_status", out var status)
               && status.GetString() == "paid";
    }

    // --- PayPal (Orders v2 REST) ----------------------------------------------

    private string PayPalBase => _settings.PayPalSandbox
        ? "https://api-m.sandbox.paypal.com"
        : "https://api-m.paypal.com";

    private async Task<string?> GetPayPalTokenAsync(CancellationToken ct)
    {
        var http = _httpFactory.CreateClient("payments");
        using var request = new HttpRequestMessage(HttpMethod.Post, $"{PayPalBase}/v1/oauth2/token");
        var credentials = Convert.ToBase64String(
            Encoding.UTF8.GetBytes($"{_settings.PayPalClientId}:{_settings.PayPalClientSecret}"));
        request.Headers.Authorization = new AuthenticationHeaderValue("Basic", credentials);
        request.Content = new FormUrlEncodedContent(new Dictionary<string, string>
        {
            ["grant_type"] = "client_credentials"
        });

        using var response = await http.SendAsync(request, ct).ConfigureAwait(false);
        if (!response.IsSuccessStatusCode) return null;
        var body = await response.Content.ReadAsStringAsync(ct).ConfigureAwait(false);
        using var doc = JsonDocument.Parse(body);
        return doc.RootElement.GetProperty("access_token").GetString();
    }

    private async Task<(string, string)?> CreatePayPalCheckoutAsync(int amountCents, string returnUrl, CancellationToken ct)
    {
        var token = await GetPayPalTokenAsync(ct).ConfigureAwait(false);
        if (token is null) return null;

        var http = _httpFactory.CreateClient("payments");
        using var request = new HttpRequestMessage(HttpMethod.Post, $"{PayPalBase}/v2/checkout/orders");
        request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);
        var amount = (amountCents / 100m).ToString("0.00", System.Globalization.CultureInfo.InvariantCulture);
        var payload = JsonSerializer.Serialize(new
        {
            intent = "CAPTURE",
            purchase_units = new[]
            {
                new { amount = new { currency_code = "USD", value = amount }, description = "DJ Tip" }
            },
            application_context = new
            {
                return_url = returnUrl + "&paid=1",
                cancel_url = returnUrl + "&paid=0",
                shipping_preference = "NO_SHIPPING",
                user_action = "PAY_NOW"
            }
        });
        request.Content = new StringContent(payload, Encoding.UTF8, "application/json");

        using var response = await http.SendAsync(request, ct).ConfigureAwait(false);
        var body = await response.Content.ReadAsStringAsync(ct).ConfigureAwait(false);
        if (!response.IsSuccessStatusCode) return null;

        using var doc = JsonDocument.Parse(body);
        var orderId = doc.RootElement.GetProperty("id").GetString();
        string? approveUrl = null;
        foreach (var link in doc.RootElement.GetProperty("links").EnumerateArray())
        {
            if (link.GetProperty("rel").GetString() == "approve")
            {
                approveUrl = link.GetProperty("href").GetString();
                break;
            }
        }
        if (orderId is null || approveUrl is null) return null;

        var paymentId = Guid.NewGuid().ToString("N");
        _pending[paymentId] = ("paypal", orderId, amountCents);
        return (approveUrl, paymentId);
    }

    private async Task<bool> CapturePayPalAsync(string orderId, CancellationToken ct)
    {
        var token = await GetPayPalTokenAsync(ct).ConfigureAwait(false);
        if (token is null) return false;

        var http = _httpFactory.CreateClient("payments");
        using var request = new HttpRequestMessage(HttpMethod.Post, $"{PayPalBase}/v2/checkout/orders/{orderId}/capture");
        request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);
        request.Content = new StringContent("{}", Encoding.UTF8, "application/json");

        using var response = await http.SendAsync(request, ct).ConfigureAwait(false);
        var body = await response.Content.ReadAsStringAsync(ct).ConfigureAwait(false);
        if (!response.IsSuccessStatusCode)
        {
            // Already captured (guest refreshed the page) still counts as paid.
            return body.Contains("ORDER_ALREADY_CAPTURED", StringComparison.OrdinalIgnoreCase);
        }

        using var doc = JsonDocument.Parse(body);
        return doc.RootElement.TryGetProperty("status", out var status)
               && status.GetString() == "COMPLETED";
    }
}
