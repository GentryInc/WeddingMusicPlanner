<Window x:Class="WeddingMusicPlannerPro.Wpf.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:WeddingMusicPlannerPro.Wpf.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
        Title="Settings - Wedding Music Planner Pro" 
        Height="500" Width="600"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" 
                   Text="API Configuration" 
                   FontSize="24" 
                   FontWeight="Bold"
                   Foreground="{StaticResource ForegroundBrush}"
                   Margin="0,0,0,24"/>

        <!-- Settings Form -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- YouTube Section -->
                <TextBlock Text="YouTube Data API v3" 
                           FontSize="18" 
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBrush}"
                           Margin="0,0,0,12"/>

                <TextBlock Text="Get your free API key from:" 
                           Foreground="{StaticResource SubtleTextBrush}"
                           Margin="0,0,0,4"/>

                <TextBlock Margin="0,0,0,8">
                    <Hyperlink NavigateUri="https://console.cloud.google.com/apis/credentials" 
                               RequestNavigate="OnHyperlinkNavigate"
                               Foreground="{StaticResource AccentBrush}">
                        https://console.cloud.google.com/apis/credentials
                    </Hyperlink>
                </TextBlock>

                <TextBlock Text="YouTube API Key:" 
                           Foreground="{StaticResource ForegroundBrush}"
                           Margin="0,0,0,4"/>

                <TextBox Text="{Binding YouTubeApiKey, UpdateSourceTrigger=PropertyChanged}"
                         Background="{StaticResource PanelBrush}"
                         Foreground="{StaticResource ForegroundBrush}"
                         BorderBrush="{StaticResource AccentBrush}"
                         Padding="8"
                         FontFamily="Consolas"
                         Margin="0,0,0,24"/>

                <!-- Spotify Section -->
                <TextBlock Text="Spotify Web API" 
                           FontSize="18" 
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBrush}"
                           Margin="0,0,0,12"/>

                <TextBlock Text="Register your app and get credentials from:" 
                           Foreground="{StaticResource SubtleTextBrush}"
                           Margin="0,0,0,4"/>

                <TextBlock Margin="0,0,0,8">
                    <Hyperlink NavigateUri="https://developer.spotify.com/dashboard" 
                               RequestNavigate="OnHyperlinkNavigate"
                               Foreground="{StaticResource AccentBrush}">
                        https://developer.spotify.com/dashboard
                    </Hyperlink>
                </TextBlock>

                <TextBlock Text="Spotify Client ID:" 
                           Foreground="{StaticResource ForegroundBrush}"
                           Margin="0,0,0,4"/>

                <TextBox Text="{Binding SpotifyClientId, UpdateSourceTrigger=PropertyChanged}"
                         Background="{StaticResource PanelBrush}"
                         Foreground="{StaticResource ForegroundBrush}"
                         BorderBrush="{StaticResource AccentBrush}"
                         Padding="8"
                         FontFamily="Consolas"
                         Margin="0,0,0,12"/>

                <TextBlock Text="Spotify Client Secret:" 
                           Foreground="{StaticResource ForegroundBrush}"
                           Margin="0,0,0,4"/>

                <PasswordBox x:Name="SpotifySecretBox"
                             Background="{StaticResource PanelBrush}"
                             Foreground="{StaticResource ForegroundBrush}"
                             BorderBrush="{StaticResource AccentBrush}"
                             Padding="8"
                             FontFamily="Consolas"
                             PasswordChanged="OnPasswordChanged"
                             Margin="0,0,0,12"/>

                <!-- Guest Requests Section -->
                <TextBlock Text="Guest Song Requests"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBrush}"
                           Margin="0,12,0,12"/>

                <CheckBox IsChecked="{Binding EnablePublicRequests}"
                          Foreground="{StaticResource ForegroundBrush}"
                          Margin="0,0,0,8"
                          Content="Allow guests outside the venue network (auto port forwarding)"/>

                <TextBlock TextWrapping="Wrap"
                           Foreground="{StaticResource SubtleTextBrush}"
                           FontSize="12"
                           Margin="0,0,0,12"
                           Text="When enabled, the app asks your router (via UPnP) to forward TCP port 8420 to this PC and the QR code uses your public internet address, so guests can request songs from any network. Requires UPnP to be enabled on the router; the request page becomes reachable from the internet while the app is running. The forwarding is removed when the app closes."/>

                <TextBlock Text="VIP (Bride) Password:"
                           Foreground="{StaticResource ForegroundBrush}"
                           Margin="0,0,0,4"/>

                <TextBox Text="{Binding BridePassword, UpdateSourceTrigger=PropertyChanged}"
                         Background="{StaticResource PanelBrush}"
                         Foreground="{StaticResource ForegroundBrush}"
                         BorderBrush="{StaticResource AccentBrush}"
                         Padding="8"
                         FontFamily="Consolas"
                         Margin="0,0,0,4"/>

                <TextBlock TextWrapping="Wrap"
                           Foreground="{StaticResource SubtleTextBrush}"
                           FontSize="12"
                           Margin="0,0,0,12"
                           Text="Share this password with the bride (or anyone who should skip the queue). Requests submitted with it on the guest page are marked VIP, jump to the front, and are approved automatically. Leave empty to disable."/>

                <!-- Info Text -->
                <Border Background="{StaticResource PanelBrush}" 
                        BorderBrush="{StaticResource AccentBrush}"
                        BorderThickness="1"
                        Padding="12"
                        Margin="0,12,0,0">
                    <TextBlock TextWrapping="Wrap"
                               Foreground="{StaticResource SubtleTextBrush}"
                               FontSize="12">
                        <Bold>Note:</Bold> API keys are stored locally on your machine and never shared. 
                        You must restart the application after saving for changes to take effect.
                    </TextBlock>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Status Message -->
        <TextBlock Grid.Row="2" 
                   Text="{Binding StatusMessage}"
                   Foreground="{StaticResource AccentBrush}"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   Margin="0,12,0,12"
                   MinHeight="20"
                   Visibility="{Binding StatusMessage, Converter={StaticResource BoolToVisibility}}"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right">
            <Button Content="Clear All" 
                    Command="{Binding ClearCommand}"
                    Margin="0,0,12,0"
                    MinWidth="100"/>

            <Button Content="Save" 
                    Command="{Binding SaveCommand}"
                    Margin="0,0,12,0"
                    MinWidth="100"/>

            <Button Content="Close" 
                    Click="OnCloseClick"
                    MinWidth="100"/>
        </StackPanel>
    </Grid>
</Window>
