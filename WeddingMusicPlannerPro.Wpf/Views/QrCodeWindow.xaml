<Window x:Class="WeddingMusicPlannerPro.Wpf.Views.QrCodeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Guest Song Requests — QR Code"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="#14141C">
    <StackPanel Margin="24">
        <TextBlock Text="Scan to request a song"
                   FontSize="20" FontWeight="SemiBold"
                   Foreground="White" HorizontalAlignment="Center"/>
        <Border Background="White" CornerRadius="8" Padding="12" Margin="0,16,0,8"
                HorizontalAlignment="Center">
            <Image x:Name="QrImage" Width="280" Height="280"
                   RenderOptions.BitmapScalingMode="NearestNeighbor"/>
        </Border>
        <TextBlock x:Name="UrlText"
                   Foreground="#B0B0C0" FontSize="13"
                   HorizontalAlignment="Center" TextWrapping="Wrap"/>
        <TextBlock x:Name="NetworkNote" Text="Guests must be on the same Wi-Fi network."
                   Foreground="#8888A0" FontSize="11" Margin="0,4,0,12"
                   HorizontalAlignment="Center" TextWrapping="Wrap"/>
        <Button Content="Save as PNG…" Padding="16,8"
                HorizontalAlignment="Center"
                Click="OnSavePng"/>
    </StackPanel>
</Window>
